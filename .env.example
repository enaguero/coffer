# Postgres
POSTGRES_USER=coffer
POSTGRES_PASSWORD=coffer
POSTGRES_DB=coffer
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# At least 32 chars and not a placeholder, or set COFFER_ENV=dev to bypass for local.
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173
# Set to "dev" or "test" to allow weak JWT_SECRET. Anything else = production.
COFFER_ENV=dev

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000

# Weekly digest email (optional). Leave SMTP_HOST empty to disable sending —
# the in-app preview (/api/v1/insights/digest/preview) works regardless.
# Digests go to each user's login email. Schedule with host cron, e.g.:
#   0 8 * * MON  cd /path/to/coffer && docker compose exec -T backend uv run python -m app.digest
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
