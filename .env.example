# Postgres
POSTGRES_USER=coffer
POSTGRES_PASSWORD=coffer
POSTGRES_DB=coffer
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# At least 32 chars and not a placeholder, or set COFFER_ENV=dev to bypass for local.
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173
# Set to "dev" or "test" to allow weak JWT_SECRET. Anything else = production.
COFFER_ENV=dev

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
