# Postgres
POSTGRES_USER=coffer
POSTGRES_PASSWORD=coffer
POSTGRES_DB=coffer
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# At least 32 chars and not a placeholder, or set COFFER_ENV=dev to bypass for local.
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173
# Set to "dev" or "test" to allow weak JWT_SECRET. Anything else = production.
COFFER_ENV=dev

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000

# Bank sync (GoCardless Bank Account Data — free EU/UK Open Banking under PSD2)
# Sign up at https://bankaccountdata.gocardless.com/ and create a User Secret to fill these.
# Leave blank to keep the feature disabled (endpoints return 503).
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=
# Where banks redirect back after the user authenticates. Must match the URI
# allowlisted in your GoCardless dashboard.
GOCARDLESS_REDIRECT_URI=http://localhost:5173/banks/callback
# HMAC key signing the `reference` we send to GoCardless. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
BANK_SYNC_STATE_SECRET=
# Optional 32-byte url-safe base64 Fernet key — forward-looking for future
# providers that need encrypted per-user bearer tokens. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
